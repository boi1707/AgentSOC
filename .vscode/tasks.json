{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AgentSOC: local application",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "scripts.dev",
        "--build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AgentSOC: isolated demo",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "scripts.dev",
        "--demo",
        "--build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AgentSOC: backend tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
