# Generate two distinct keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_KEY=
APPROVE_KEY=
DB=data/agentsoc.db
BIND_IP=127.0.0.1
# mock is offline and deterministic; live sends pseudonymized evidence to your endpoint.
LLM_MODE=mock
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
MIN_CONFIDENCE=0.85
QUIET_SECONDS=30
GAP_SECONDS=600
POLL_SECONDS=2
HI_LEVEL=12
CAP=40
LOG_LEVEL=INFO
HOST_IPS={"10.8.0.3":"192.168.10.20"}
HOST_NAMES=win-victim,gateway,kali
# ssh requires LLM_MODE=live, a pinned host key, and gateway configuration.
RESPONSE_MODE=dry-run
GATEWAY=10.8.0.2
SSH_KEY=data/block_key
KNOWN_HOSTS=data/known_hosts
TG_TOKEN=
TG_CHAT=
# First startup only. Leave ADMIN_PASSWORD empty to bootstrap with APPROVE_KEY.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=0
# API and worker are separate by default. Only use 1 for deliberate single-process development.
EMBEDDED_WORKER=0
JOB_LEASE_SECONDS=120
WAZUH_SOURCE_ID=wazuh
# Demo mode always uses DEMO_DB, ignores DB and requires mock/dry-run/no Telegram.
DEMO_MODE=0
DEMO_DB=data/demo/agentsoc.db
