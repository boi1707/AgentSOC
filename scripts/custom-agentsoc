#!/usr/bin/env python3
"""Wazuh custom integration: argv = script alert_file api_key hook_url."""
import json
import sys
import urllib.request


def main():
    if len(sys.argv) < 4:
        return 2
    with open(sys.argv[1], encoding="utf-8") as source:
        payload = json.load(source)
    request = urllib.request.Request(sys.argv[3], data=json.dumps(payload).encode(),
                                     headers={"Authorization": "Bearer " + sys.argv[2],
                                              "Content-Type": "application/json"}, method="POST")
    with urllib.request.urlopen(request, timeout=10) as response:
        return 0 if response.status == 202 else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        print("AgentSOC delivery failed; inspect manager connectivity", file=sys.stderr)
        sys.exit(1)
